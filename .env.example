# One-time owner bootstrap. Set these as protected runtime secrets, sign in once,
# then create Administrator and Editor accounts from Team Access.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Hostinger MySQL. Create these in hPanel and store the values only in the
# protected Web App environment settings.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Optional machine-to-machine key for approved automation. Human staff use
# password sessions and never share this value.
ADMIN_WRITE_TOKEN=

# Existing VPS n8n endpoints. All four use the same protected request secret.
N8N_PUBLISH_WEBHOOK=
N8N_SUBSCRIBE_ALERT_WEBHOOK=
N8N_EVENT_MAIL_WEBHOOK=

# Organisation-owned CRM alert channels. Keep disabled until the charity
# supplies its dedicated email address, Telegram bot/channel and approved n8n
# webhook. Never use a staff member's personal email or Telegram account.
CRM_ALERTS_ENABLED=false
CRM_ALERT_EMAIL=
CRM_TELEGRAM_CHAT_ID=
N8N_INQUIRY_ALERT_WEBHOOK=
N8N_INQUIRY_WEBHOOK_SECRET=

# Private Admin assistant. Keep the key server-side and disabled until reviewed.
MR_KYAW_ZIN_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Optional approved project-document knowledge base for Responses API file search.
OPENAI_VECTOR_STORE_ID=
